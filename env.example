# =================================================================
# HUNTER PACE APP ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control!

# =================================================================
# FIREBASE CLIENT CONFIGURATION (Required)
# =================================================================
# Get these values from Firebase Console > Project Settings > General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# =================================================================
# FIREBASE OPTIONAL CONFIGURATION
# =================================================================
# Optional: For Google Analytics (can be left empty if not using analytics)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Optional: Firebase Functions URL (auto-generated if using default region)
NEXT_PUBLIC_FIREBASE_FUNCTIONS_URL=https://us-central1-your_project_id.cloudfunctions.net

# =================================================================
# DEVELOPMENT SETTINGS
# =================================================================
# Set to 'true' to use Firebase emulators in development
NEXT_PUBLIC_USE_EMULATORS=false

# =================================================================
# GOOGLE CLOUD PLATFORM (For Server-Side Functions)
# =================================================================
# Used by Firebase Functions and server-side operations
GOOGLE_CLOUD_PROJECT=your_project_id

# Path to service account key (use absolute path or place in .secrets/ directory)
# Example: /absolute/path/to/your/serviceAccountKey.json
# Or: ./.secrets/firebase-functions-key.json
GOOGLE_APPLICATION_CREDENTIALS=./.secrets/firebase-functions-key.json

# =================================================================
# APP CONFIGURATION
# =================================================================
NEXT_PUBLIC_APP_NAME=Hunter Pace App
NEXT_PUBLIC_APP_VERSION=1.0.0

# Environment: development, staging, production
NEXT_PUBLIC_APP_ENVIRONMENT=development

# =================================================================
# SECURITY SETTINGS
# =================================================================
# JWT secret for API authentication (generate a strong random string)
JWT_SECRET=your_jwt_secret_here_use_a_long_random_string

# API rate limiting (requests per minute)
API_RATE_LIMIT=100

# =================================================================
# DEVELOPMENT ONLY
# =================================================================
# Enable debug logging in development
DEBUG=false

# Show detailed error messages (only use in development!)
SHOW_STACK_TRACES=false

