rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Events - public read, authenticated write for organizers
    match /events/{eventId} {
      allow read: if true; // Public read access
      allow write: if request.auth != null && 
        (resource == null || resource.data.organizerId == request.auth.uid);
      
      // Divisions subcollection
      match /divisions/{divisionId} {
        allow read: if true;
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
      }
      
      // Teams subcollection
      match /teams/{teamId} {
        allow read: if true;
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
      }
      
      // Results subcollection
      match /results/{resultId} {
        allow read: if true;
        allow write: if request.auth != null && 
          get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
      }
    }
    
    // Public leaderboards
    match /leaderboards/{eventId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public slugs: maps a customizable slug to an eventId for the
    // public live-results page. Doc ID IS the slug.
    // - Anyone can read (public live page).
    // - Only the event's organizer can claim/update/delete a slug.
    match /publicSlugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.organizerId == request.auth.uid;
    }

    // Public live-page analytics. Anyone (the public live page) can
    // increment counters and write their own session presence doc.
    // Only the event organizer can read the aggregate stats.
    match /eventStats/{eventId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
      // Public can create or update aggregate counters (view count + lastViewAt).
      allow create, update: if true;
      // Only the organizer can wipe analytics.
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;

      match /sessions/{sessionId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
        // Each viewer freely writes their own session presence doc.
        allow write: if true;
      }
    }
    
    // App settings - admin only
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}

