rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - users can upload their own
    match /profile-pictures/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Event images - public read, organizers can upload
    match /event-images/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Event documents - public read, organizers can upload
    match /event-documents/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Results exports - public read, authenticated write
    match /results-exports/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // General rule - authenticated users can upload, public can read
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}

